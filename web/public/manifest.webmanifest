{
  "name": "Termyard",
  "short_name": "Termyard",
  "description": "Terminal session manager with agent tool notifications",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0E1011",
  "theme_color": "#0E1011",
  "orientation": "portrait",
