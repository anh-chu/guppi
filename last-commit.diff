+ 359: // GetAllSessions returns sessions from all hosts, with host fields stamped.
+ 360: // The returned slice and session values are copies so callers cannot mutate
+ 361: // internal manager state.
+ 362: func (m *Manager) GetAllSessions() []*model.Session {
+ 363: 	m.mu.RLock()
+ 364: 	defer m.mu.RUnlock()
+ 365: 
+ 366: 	var all []*model.Session
+ 367: 	for _, h := range m.hosts {
+ 368: 		for _, s := range h.Sessions {
+ 369: 			copyS := copySession(s)
+ 370: 			copyS.Host = h.ID
+ 371: 			copyS.HostName = h.Name
+ 372: 			copyS.HostOnline = h.Connected
+ 373: 			all = append(all, copyS)
+ 374: 		}
+ 375: 	}
+ 376: 	return all
+ 377: }
