+ 162: // Close marks the connection closed. Idempotent. The lanes are never closed
+ 163: // (producers gate on the closed flag under mu), so there is no send-on-closed
+ 164: // race; the writer goroutine exits via Done.
+ 165: func (pc *PeerConnection) Close() {
+ 166: 	pc.mu.Lock()
+ 167: 	defer pc.mu.Unlock()
+ 168: 	if pc.closed {
+ 169: 		return
+ 170: 	}
+ 171: 	pc.closed = true
+ 172: 	close(pc.done)
+ 173: }
