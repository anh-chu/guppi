+ 379: func copySession(s *model.Session) *model.Session {
+ 380: 	if s == nil {
+ 381: 		return nil
+ 382: 	}
+ 383: 	c := *s
+ 384: 	if len(s.Windows) &gt; 0 {
+ 385: 		c.Windows = make([]*model.Window, 0, len(s.Windows))
+ 386: 		for _, w := range s.Windows {
+ 387: 			if w == nil {
+ 388: 				c.Windows = append(c.Windows, nil)
+ 389: 				continue
+ 390: 			}
+ 391: 			cw := *w
+ 392: 			if len(w.Panes) &gt; 0 {
+ 393: 				cw.Panes = make([]*model.Pane, 0, len(w.Panes))
+ 394: 				for _, p := range w.Panes {
+ 395: 					if p == nil {
+ 396: 						cw.Panes = append(cw.Panes, nil)
+ 397: 						continue
+ 398: 					}
+ 399: 					cp := *p
+ 400: 					cw.Panes = append(cw.Panes, &amp;cp)
+ 401: 				}
+ 402: 			}
+ 403: 			c.Windows = append(c.Windows, &amp;cw)
+ 404: 		}
+ 405: 	}
+ 406: 	return &amp;c
+ 407: }
