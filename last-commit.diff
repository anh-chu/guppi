+ 861: 	if owner == state.OwnerID(m.localID) {
+ 862: 		return true
+ 863: 	}
+ 864: 	peerID := m.peerIDForOwner(owner)
+ 865: 	if peerID == &quot;&quot; {
+ 866: 		return false
+ 867: 	}
+ 868: 	pc := m.GetPeerConnection(peerID)
+ 869: 	return pc != nil &amp;&amp; pc.HasV2()
