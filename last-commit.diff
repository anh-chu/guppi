+ 536: // TryRegisterPeer atomically registers a peer iff no live connection exists
+ 537: // for the same fingerprint. Returns true on success. Used by session.runSession
+ 538: // to close the simultaneous-initiate race window.
+ 539: func (m *Manager) TryRegisterPeer(id, name, publicKey, address string, conn *PeerConnection) bool {
+ 540: 	m.mu.Lock()
+ 541: 	if h, ok := m.hosts[id]; ok &amp;&amp; h.Conn != nil {
+ 542: 		m.mu.Unlock()
+ 543: 		return false
+ 544: 	}
+ 545: 	m.hosts[id] = &amp;HostState{
+ 546: 		ID:        id,
+ 547: 		Name:      name,
+ 548: 		PublicKey: publicKey,
+ 549: 		Address:   address,
+ 550: 		Connected: true,
+ 551: 		LastSeen:  time.Now(),
+ 552: 		Conn:      conn,
+ 553: 	}
+ 554: 	m.mu.Unlock()
+ 555: 
+ 556: 	m.resetRemoteRevisions(id)
+ 557: 
+ 558: 	m.broadcast(state.StateEvent{
+ 559: 		Type:     &quot;peer-connected&quot;,
+ 560: 		Host:     id,
+ 561: 		HostName: name,
+ 562: 	})
+ 563: 
+ 564: 	logrus.WithFields(logrus.Fields{
+ 565: 		&quot;peer&quot;: name,
+ 566: 		&quot;id&quot;:   id,
+ 567: 	}).Info(&quot;peer connected&quot;)
+ 568: 	return true
+ 569: }
