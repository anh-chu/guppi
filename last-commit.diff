+  59: // PeerConnection wraps a control WebSocket to a peer. Sends are gated behind
+  60: // Enqueue*/Close so concurrent producers cannot race the close, and split into
+  61: // two priority lanes so bulky control-plane messages never block PTY frames
+  62: // (head-of-line blocking was the dominant source of typing jitter).
+  63: type PeerConnection struct {
+  64: 	HostID string
+  65: 	Role   Role
+  66: 	Caps   []string
+  67: 
+  68: 	mu     sync.Mutex
+  69: 	hi     chan wireFrame
+  70: 	lo     chan wireFrame
+  71: 	done   chan struct{}
+  72: 	closed bool
+  73: 
+  74: 	// v2 coalescing snapshot slots and reliable command queue.
+  75: 	catalogSlot   *snapshotSlot
+  76: 	workspaceSlot *snapshotSlot
+  77: 	cmdQueue      *reliableCommandQueue
+  78: }
