+ 639: // validateCatalogOwnership checks that all sessions and layouts in the snapshot
+ 640: // have their Owner field matching the snapshot&apos;s top-level owner. Returns false
+ 641: // and logs a warning if any embedded owner differs.
+ 642: func validateCatalogOwnership(peerID string, snap state.OwnerCatalogSnapshot) bool {
+ 643: 	for _, sess := range snap.Sessions {
+ 644: 		if sess.Owner != snap.Owner {
+ 645: 			logrus.WithFields(logrus.Fields{
+ 646: 				&quot;peer&quot;: peerID,
+ 647: 				&quot;owner&quot;: string(snap.Owner),
+ 648: 				&quot;session_id&quot;: string(sess.ID),
+ 649: 				&quot;session_owner&quot;: string(sess.Owner),
+ 650: 			}).Warn(&quot;dropping v2 snapshot: embedded session owner mismatch&quot;)
+ 651: 			return false
+ 652: 		}
+ 653: 	}
+ 654: 	for _, layout := range snap.Layouts {
+ 655: 		if layout.Owner != snap.Owner {
+ 656: 			logrus.WithFields(logrus.Fields{
+ 657: 				&quot;peer&quot;: peerID,
+ 658: 				&quot;owner&quot;: string(snap.Owner),
+ 659: 				&quot;layout_id&quot;: string(layout.ID),
+ 660: 				&quot;layout_owner&quot;: string(layout.Owner),
+ 661: 			}).Warn(&quot;dropping v2 snapshot: embedded layout owner mismatch&quot;)
+ 662: 			return false
+ 663: 		}
+ 664: 	}
+ 665: 	return true
+ 666: }
+ 667: 
+ 668: // validateWorkspaceTreeOwnership recursively checks that all leaf SessionRefs in
+ 669: // the tree have owner matching rec.Owner. Returns false and logs a warning if
+ 670: // any leaf ref differs.
+ 671: func validateWorkspaceTreeOwnership(peerID string, rec state.WorkspaceRecord) bool {
+ 672: 	var checkNode func(*state.PaneNode) bool
+ 673: 	checkNode = func(node *state.PaneNode) bool {
+ 674: 		if node == nil {
+ 675: 			return true
+ 676: 		}
+ 677: 		if node.IsLeaf() {
+ 678: 			if node.Ref != nil &amp;&amp; node.Ref.Owner != rec.Owner {
+ 679: 				logrus.WithFields(logrus.Fields{
+ 680: 					&quot;peer&quot;: peerID,
+ 681: 					&quot;owner&quot;: string(rec.Owner),
+ 682: 					&quot;layout_id&quot;: string(rec.ID),
+ 683: 					&quot;ref_owner&quot;: string(node.Ref.Owner),
+ 684: 				}).Warn(&quot;dropping v2 snapshot: embedded leaf owner mismatch&quot;)
+ 685: 				return false
+ 686: 			}
+ 687: 			return true
+ 688: 		}
+ 689: 		if node.IsSplit() {
+ 690: 			if !checkNode(node.First) || !checkNode(node.Second) {
+ 691: 				return false
+ 692: 			}
+ 693: 		}
+ 694: 		return true
+ 695: 	}
+ 696: 	return checkNode(&amp;rec.Tree)
+ 697: }
