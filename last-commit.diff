+ 106: // Done returns a channel that is closed when the connection is closed. Lets
+ 107: // consumers (e.g. the browser-input pump) react when the underlying peer link
+ 108: // dies and tear down dependent state instead of silently dropping messages.
+ 109: func (pc *PeerConnection) Done() &lt;-chan struct{} {
