+ 123: function indexOfU8(haystack: Uint8Array, needle: Uint8Array, start = 0): number {
+ 124:   if (needle.length === 0) return start
+ 125:   outer: for (let i = start; i &lt;= haystack.length - needle.length; i++) {
+ 126:     for (let j = 0; j &lt; needle.length; j++) {
+ 127:       if (haystack[i + j] !== needle[j]) continue outer
+ 128:     }
+ 129:     return i
+ 130:   }
+ 131:   return -1
+ 132: }
