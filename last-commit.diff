 // v2RuntimeEnricher supplies live runtime fields for v2 catalog records
 // without mutating persisted state.
 type v2RuntimeEnricher struct {
-	adapter *daemonAdapter
+	adapter    *daemonAdapter
+	actTracker *activity.Tracker
