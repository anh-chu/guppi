+ 128: func (pc *PeerConnection) enqueue(ch chan wireFrame, f wireFrame) bool {
+ 129: 	pc.mu.Lock()
+ 130: 	defer pc.mu.Unlock()
+ 131: 	if pc.closed {
+ 132: 		return false
+ 133: 	}
+ 134: 	select {
+ 135: 	case ch &lt;- f:
+ 136: 		return true
+ 137: 	default:
+ 138: 		return false
+ 139: 	}
+ 140: }
