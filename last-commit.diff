+ 723: // UpdateRemoteCatalog replaces the cached catalog for the snapshot&apos;s owner.
+ 724: // The previous cache (if any) is overwritten, not merged. The owner must be
+ 725: // the peer&apos;s bound owner and the revision must be increasing within the
+ 726: // peer&apos;s current connection (stale/delayed snapshots are rejected). All
+ 727: // embedded session and layout owners must match the snapshot&apos;s owner. If a
+ 728: // remote store is wired, the complete set of accepted remote catalogs is
+ 729: // persisted.
+ 730: func (m *Manager) UpdateRemoteCatalog(peerID string, snap state.OwnerCatalogSnapshot) {
+ 731: 	if !validateCatalogOwnership(peerID, snap) {
+ 732: 		return
+ 733: 	}
+ 734: 	m.catalogMu.Lock()
+ 735: 	if !m.bindRemoteOwner(peerID, snap.Owner) {
+ 736: 		m.catalogMu.Unlock()
+ 737: 		return
+ 738: 	}
+ 739: 	rs := m.remoteRevs[peerID]
+ 740: 	if rs == nil {
+ 741: 		rs = &amp;remoteRevisionState{catalog: -1}
+ 742: 		m.remoteRevs[peerID] = rs
+ 743: 	}
+ 744: 	if rs.catalog &gt;= 0 &amp;&amp; snap.Revision &lt;= rs.catalog {
+ 745: 		m.catalogMu.Unlock()
+ 746: 		logrus.WithFields(logrus.Fields{&quot;peer&quot;: peerID, &quot;rev&quot;: snap.Revision, &quot;last&quot;: rs.catalog}).Debug(&quot;dropping stale v2 catalog snapshot&quot;)
+ 747: 		return
+ 748: 	}
+ 749: 	rs.catalog = snap.Revision
+ 750: 	m.remoteCatalogs[snap.Owner] = remoteCatalogCache{
+ 751: 		Owner:      snap.Owner,
+ 752: 		PeerID:     peerID,
+ 753: 		Snapshot:   snap,
+ 754: 		ReceivedAt: time.Now(),
+ 755: 		CatalogRev: snap.Revision,
+ 756: 	}
+ 757: 	m.catalogMu.Unlock()
+ 758: 	m.persistRemoteCatalogs()
+ 759: }
+ 760: 
+ 761: // UpdateRemoteWorkspace replaces the cached workspace for owner. The owner
+ 762: // must be the peer&apos;s bound owner, and the workspace revision must be
+ 763: // increasing within the current connection (keyed per layout id). All
+ 764: // embedded leaf SessionRefs in the tree must have owner matching rec.Owner.
+ 765: func (m *Manager) UpdateRemoteWorkspace(peerID string, rec state.WorkspaceRecord) {
+ 766: 	if !validateWorkspaceTreeOwnership(peerID, rec) {
+ 767: 		return
+ 768: 	}
+ 769: 	m.catalogMu.Lock()
+ 770: 	if !m.bindRemoteOwner(peerID, rec.Owner) {
+ 771: 		m.catalogMu.Unlock()
+ 772: 		return
+ 773: 	}
+ 774: 	rs := m.remoteRevs[peerID]
+ 775: 	if rs == nil {
+ 776: 		rs = &amp;remoteRevisionState{catalog: -1}
+ 777: 		m.remoteRevs[peerID] = rs
+ 778: 	}
+ 779: 	if rs.workspace == nil {
+ 780: 		rs.workspace = make(map[state.LayoutID]int64)
+ 781: 	}
+ 782: 	if last, seen := rs.workspace[rec.ID]; seen &amp;&amp; rec.Revision &lt;= last {
+ 783: 		m.catalogMu.Unlock()
+ 784: 		logrus.WithFields(logrus.Fields{&quot;peer&quot;: peerID, &quot;layout&quot;: string(rec.ID), &quot;rev&quot;: rec.Revision, &quot;last&quot;: last}).Debug(&quot;dropping stale v2 workspace snapshot&quot;)
+ 785: 		return
+ 786: 	}
+ 787: 	rs.workspace[rec.ID] = rec.Revision
+ 788: 	cache := m.remoteCatalogs[rec.Owner]
+ 789: 	cache.Owner = rec.Owner
+ 790: 	cache.PeerID = peerID
+ 791: 	cache.Workspace = &amp;rec
+ 792: 	cache.ReceivedAt = time.Now()
+ 793: 	cache.WorkspaceRev = rec.Revision
+ 794: 	m.remoteCatalogs[rec.Owner] = cache
+ 795: 	m.catalogMu.Unlock()
+ 796: 	m.persistRemoteCatalogs()
+ 797: }
