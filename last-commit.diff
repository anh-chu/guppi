+ 126: // ── Fake Terminal ─────────────────────────────────────────────────────
+ 127: 
+ 128: class FakeTerminal {
+ 129:   options: any
+ 130:   element: HTMLElement
+ 131:   cols = 80
+ 132:   rows = 24
+ 133:   buffer = {
+ 134:     active: {
+ 135:       type: &apos;normal&apos; as const,
+ 136:       cursorX: 0, cursorY: 0,
+ 137:       baseY: 100, viewportY: 95, length: 100,
+ 138:       getLine: (_i: number) =&gt; null,
+ 139:     },
+ 140:   }
+ 141:   private _dataListeners: Array&lt;(data: string) =&gt; void&gt; = []
+ 142:   private _resizeListeners: Array&lt;(info: { cols: number; rows: number }) =&gt; void&gt; = []
+ 143: 
+ 144:   constructor(options: any) {
+ 145:     terminalCreateCount++
+ 146:     this.options = options
+ 147:     this.element = fakeEl()
+ 148:   }
+ 149: 
+ 150:   loadAddon(_addon: any) { addonCreateCount++ }
+ 151:   open(_container: HTMLElement) {}
+ 152:   dispose() { terminalDisposeCount++ }
+ 153:   onData(fn: (data: string) =&gt; void) {
+ 154:     this._dataListeners.push(fn)
+ 155:     return { dispose: () =&gt; {
+ 156:       const idx = this._dataListeners.indexOf(fn)
+ 157:       if (idx &gt; -1) this._dataListeners.splice(idx, 1)
+ 158:     }}
+ 159:   }
+ 160:   onResize(fn: (info: { cols: number; rows: number }) =&gt; void) {
+ 161:     this._resizeListeners.push(fn)
+ 162:     return { dispose: () =&gt; {
+ 163:       const idx = this._resizeListeners.indexOf(fn)
+ 164:       if (idx &gt; -1) this._resizeListeners.splice(idx, 1)
+ 165:     }}
+ 166:   }
+ 167:   onSelectionChange(_fn: () =&gt; void) { return { dispose: () =&gt; {} } }
+ 168:   attachCustomKeyEventHandler(_fn: (e: any) =&gt; boolean) {}
+ 169:   getSelection() { return &apos;&apos; }
+ 170:   clearSelection() {}
+ 171:   scrollToBottom() {}
+ 172:   scrollLines(_delta: number) {}
+ 173:   focus() {}
+ 174:   refresh(_start: number, _end: number) {}
+ 175:   writes: { data: Uint8Array | string; cb?: () =&gt; void }[] = []
+ 176:   write(data: any, cb?: () =&gt; void) {
+ 177:     if (data instanceof ArrayBuffer) {
+ 178:       this.writes.push({ data: new Uint8Array(data), cb })
+ 179:     } else if (typeof data === &apos;object&apos; &amp;&amp; data &amp;&amp; typeof data.length === &apos;number&apos; &amp;&amp; !(data instanceof Uint8Array)) {
+ 180:       this.writes.push({ data: new Uint8Array(data), cb })
+ 181:     } else {
+ 182:       this.writes.push({ data, cb })
+ 183:     }
+ 184:     if (cb) cb()
+ 185:   }
+ 186: 
+ 187:   _fireData(data: string) { this._dataListeners.forEach(fn =&gt; fn(data)) }
+ 188:   _fireResize(cols: number, rows: number) {
+ 189:     this.cols = cols; this.rows = rows
+ 190:     this._resizeListeners.forEach(fn =&gt; fn({ cols, rows }))
+ 191:   }
+ 192: }
