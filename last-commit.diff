+ 277: // Run starts forwarding local state events to peer manager subscribers
+ 278: // and pruning offline peers. Blocks until ctx is cancelled.
+ 279: func (m *Manager) Run(ctx context.Context) {
+ 280: 	// Forward local state events
+ 281: 	localCh := m.localMgr.Subscribe()
+ 282: 	defer m.localMgr.Unsubscribe(localCh)
+ 283: 
+ 284: 	pruneTimer := time.NewTicker(30 * time.Second)
+ 285: 	defer pruneTimer.Stop()
+ 286: 
+ 287: 	statsTimer := time.NewTicker(30 * time.Second)
+ 288: 	defer statsTimer.Stop()
+ 289: 
+ 290: 	// Collect initial stats
+ 291: 	m.updateLocalStats()
+ 292: 
+ 293: 	for {
+ 294: 		select {
+ 295: 		case evt, ok := &lt;-localCh:
+ 296: 			if !ok {
+ 297: 				return
+ 298: 			}
+ 299: 			// Stamp with local host info
+ 300: 			evt.Host = m.localID
+ 301: 			evt.HostName = m.localName
+ 302: 
+ 303: 			// Update local sessions cache
+ 304: 			m.mu.Lock()
+ 305: 			if h, ok := m.hosts[m.localID]; ok {
+ 306: 				h.Sessions = m.localMgr.GetSessions()
+ 307: 				h.LastSeen = time.Now()
+ 308: 			}
+ 309: 			m.mu.Unlock()
+ 310: 
+ 311: 			m.broadcast(evt)
+ 312: 
+ 313: 		case &lt;-statsTimer.C:
+ 314: 			m.updateLocalStats()
+ 315: 
+ 316: 		case &lt;-pruneTimer.C:
+ 317: 			m.pruneOffline()
+ 318: 
+ 319: 		case &lt;-ctx.Done():
+ 320: 			return
+ 321: 		}
+ 322: 	}
+ 323: }
