+ 699: // bindRemoteOwner enforces the ownership binding: one owner per peer and one
+ 700: // peer per owner. The first snapshot a peer publishes establishes its sole
+ 701: // owner; a later snapshot from the same peer under a different owner, or a
+ 702: // second peer claiming an already-bound owner, is a spoof and is dropped.
+ 703: // Caller must hold catalogMu. The v2 catalog Owner is a random base32 id, NOT
+ 704: // the peer fingerprint, so an explicit cross-peer binding map is the sound
+ 705: // integrity mechanism here.
+ 706: func (m *Manager) bindRemoteOwner(peerID string, owner state.OwnerID) bool {
+ 707: 	if peerID == &quot;&quot; || owner == &quot;&quot; {
+ 708: 		return false
+ 709: 	}
+ 710: 	if p, ok := m.ownerPeer[owner]; ok &amp;&amp; p != peerID {
+ 711: 		logrus.WithFields(logrus.Fields{&quot;peer&quot;: peerID, &quot;owner&quot;: string(owner), &quot;boundPeer&quot;: p}).Warn(&quot;dropping v2 snapshot: owner already bound to another peer&quot;)
+ 712: 		return false
+ 713: 	}
+ 714: 	if o, ok := m.peerOwner[peerID]; ok &amp;&amp; o != owner {
+ 715: 		logrus.WithFields(logrus.Fields{&quot;peer&quot;: peerID, &quot;owner&quot;: string(owner), &quot;boundOwner&quot;: string(o)}).Warn(&quot;dropping v2 snapshot: peer switched owners&quot;)
+ 716: 		return false
+ 717: 	}
+ 718: 	m.peerOwner[peerID] = owner
+ 719: 	m.ownerPeer[owner] = peerID
+ 720: 	return true
+ 721: }
