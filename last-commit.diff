+ 504: // RegisterPeerWithAddress registers a newly connected peer with its address.
+ 505: func (m *Manager) RegisterPeerWithAddress(id, name, publicKey, address string, conn *PeerConnection) {
+ 506: 	m.mu.Lock()
+ 507: 	m.hosts[id] = &amp;HostState{
+ 508: 		ID:        id,
+ 509: 		Name:      name,
+ 510: 		PublicKey: publicKey,
+ 511: 		Address:   address,
+ 512: 		Connected: true,
+ 513: 		LastSeen:  time.Now(),
+ 514: 		Conn:      conn,
+ 515: 	}
+ 516: 	m.mu.Unlock()
+ 517: 
+ 518: 	// A new connection is a new snapshot-stream generation: reset the
+ 519: 	// revision baseline so a restarted peer&apos;s re-emitted snapshots are
+ 520: 	// accepted even though their revisions are lower than the last ones seen
+ 521: 	// on the previous connection.
+ 522: 	m.resetRemoteRevisions(id)
+ 523: 
+ 524: 	m.broadcast(state.StateEvent{
+ 525: 		Type:     &quot;peer-connected&quot;,
+ 526: 		Host:     id,
+ 527: 		HostName: name,
+ 528: 	})
+ 529: 
+ 530: 	logrus.WithFields(logrus.Fields{
+ 531: 		&quot;peer&quot;: name,
+ 532: 		&quot;id&quot;:   id,
+ 533: 	}).Info(&quot;peer connected&quot;)
+ 534: }
