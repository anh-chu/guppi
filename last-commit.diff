+ 835: // WorkspaceAuthority returns the owning owner for layout and, when the owner is
+ 836: // remote, the peer ID that last advertised it. The empty peerID means this node
+ 837: // is the authority.
+ 838: func (m *Manager) WorkspaceAuthority(layout state.LayoutID) (state.OwnerID, string, error) {
+ 839: 	if cat := m.localMgr.V2Catalog(); cat != nil {
+ 840: 		if rec, ok := cat.Layout(layout); ok {
+ 841: 			return rec.Owner, &quot;&quot;, nil
+ 842: 		}
+ 843: 	}
+ 844: 	m.catalogMu.RLock()
+ 845: 	defer m.catalogMu.RUnlock()
+ 846: 	for owner, cache := range m.remoteCatalogs {
+ 847: 		for _, l := range cache.Snapshot.Layouts {
+ 848: 			if l.ID == layout {
+ 849: 				return owner, cache.PeerID, nil
+ 850: 			}
+ 851: 		}
+ 852: 		if cache.Workspace != nil &amp;&amp; cache.Workspace.ID == layout {
+ 853: 			return owner, cache.PeerID, nil
+ 854: 		}
+ 855: 	}
+ 856: 	return &quot;&quot;, &quot;&quot;, state.StateError{Code: state.ErrUnknownLayout, Field: &quot;layout&quot;, Detail: fmt.Sprintf(&quot;workspace authority not found for layout %q&quot;, layout)}
+ 857: }
