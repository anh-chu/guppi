+301:       for (let i = 0; i &lt; Math.abs(lines); i++) {
+302:         const wheelEvent = new WheelEvent(&apos;wheel&apos;, {
+303:           deltaY: lines &gt; 0 ? BASE_LINE_HEIGHT : -BASE_LINE_HEIGHT,
+304:           deltaMode: 0,
