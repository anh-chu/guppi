+  80: // NewPeerConnection constructs a PeerConnection with buffered priority lanes.
+  81: // bufSize seeds the low-priority lane; the hi lane is fixed-deep.
+  82: func NewPeerConnection(hostID string, bufSize int) *PeerConnection {
+  83: 	if bufSize &lt; loQueueDepth {
+  84: 		bufSize = loQueueDepth
+  85: 	}
+  86: 	return &amp;PeerConnection{
+  87: 		HostID: hostID,
+  88: 		hi:     make(chan wireFrame, hiQueueDepth),
+  89: 		lo:     make(chan wireFrame, bufSize),
+  90: 		done:   make(chan struct{}),
+  91: 	}
+  92: }
