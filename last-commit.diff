+ 111: export function concatU8Legacy(parts: Uint8Array[]): Uint8Array {
+ 112:   let len = 0
+ 113:   for (const p of parts) len += p.length
+ 114:   const out = new Uint8Array(len)
+ 115:   let off = 0
+ 116:   for (const p of parts) {
+ 117:     out.set(p, off)
+ 118:     off += p.length
+ 119:   }
+ 120:   return out
+ 121: }
