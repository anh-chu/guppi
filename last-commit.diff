+  94: // initV2Lazy lazily initializes v2 slots/queue. It is safe to call multiple
+  95: // times because a real PeerConnection is created once per connection.
+  96: func (pc *PeerConnection) initV2Lazy() {
+  97: 	pc.mu.Lock()
+  98: 	defer pc.mu.Unlock()
+  99: 	if pc.catalogSlot == nil {
+ 100: 		pc.catalogSlot = newSnapshotSlot()
+ 101: 		pc.workspaceSlot = newSnapshotSlot()
+ 102: 		pc.cmdQueue = newReliableCommandQueue(32)
+ 103: 	}
