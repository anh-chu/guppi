+ 748:   applyGlobalPrefs(prefs: TerminalPrefs): void {
+ 749:     for (const entry of this.entries.values()) {
+ 750:       const prevScrollback = entry.appliedPrefs?.scrollback
+ 751:       const newScrollback = prefs.scrollback
+ 752: 
+ 753:       // Scrollback change triggers rebuild
+ 754:       if (prevScrollback !== undefined &amp;&amp; prevScrollback !== newScrollback) {
+ 755:         // Capture identity before disposal
+ 756:         const identity = entry.identity
+ 757:         const key = entry.key
+ 758:         const wasActive = entry.activeContainer !== null
+ 759:         const prevContainer = entry.activeContainer
+ 760: 
+ 761:         this.disposeEntry(entry)
+ 762:         this.entries.delete(key)
+ 763: 
+ 764:         const newEntry = this.createEntry(key, identity, prefs, this.factory)
+ 765:         this.entries.set(key, newEntry)
+ 766: 
+ 767:         if (wasActive &amp;&amp; prevContainer) {
+ 768:           // Re-checkout into same container
