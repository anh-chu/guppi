+ 350: 	defer m.subMu.RUnlock()
+ 351: 	for _, ch := range m.subscribers {
+ 352: 		select {
+ 353: 		case ch &lt;- evt:
+ 354: 		default:
+ 355: 		}
+ 356: 	}
+ 357: }
