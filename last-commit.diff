+ 334: // Unsubscribe removes a subscriber channel
+ 335: func (m *Manager) Unsubscribe(ch chan state.StateEvent) {
+ 336: 	m.subMu.Lock()
+ 337: 	defer m.subMu.Unlock()
+ 338: 	for i, sub := range m.subscribers {
+ 339: 		if sub == ch {
+ 340: 			m.subscribers = append(m.subscribers[:i], m.subscribers[i+1:]...)
+ 341: 			close(ch)
+ 342: 			return
+ 343: 		}
+ 344: 	}
+ 345: }
