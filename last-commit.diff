+ 142: // Enqueue best-effort queues a control-plane JSON message on the low-priority
+ 143: // lane. Returns false if the connection was closed or the lane is full.
+ 144: func (pc *PeerConnection) Enqueue(msg *Message) bool {
+ 145: 	data, err := json.Marshal(msg)
+ 146: 	if err != nil {
+ 147: 		return false
+ 148: 	}
+ 149: 	return pc.enqueue(pc.lo, wireFrame{data: data})
+ 150: }
+ 151: 
+ 152: // EnqueueHi best-effort queues a small interactive JSON message (e.g. PTY
+ 153: // resize/control) on the high-priority lane.
+ 154: func (pc *PeerConnection) EnqueueHi(msg *Message) bool {
+ 155: 	data, err := json.Marshal(msg)
+ 156: 	if err != nil {
+ 157: 		return false
+ 158: 	}
+ 159: 	return pc.enqueue(pc.hi, wireFrame{data: data})
+ 160: }
