+  92:       overflow: &apos;&apos;, pointerEvents: &apos;&apos;, visibility: &apos;&apos;, opacity: &apos;&apos;,
+  93:     } as unknown as CSSStyleDeclaration,
+  94: 
+  95:     clientWidth: 800,
+  96:     clientHeight: 600,
+  97:     scrollTop: 0,
+  98: 
+  99:     querySelector(_sel: string): HTMLElement | null { return null },
+ 100:     getElementsByClassName(): HTMLCollectionOf&lt;Element&gt; { return { length: 0, item: () =&gt; null, namedItem: () =&gt; null } as any },
+ 101:     querySelectorAll(): NodeListOf&lt;Element&gt; { return { length: 0, item: () =&gt; null, forEach: () =&gt; {} } as any },
+ 102: 
+ 103:     addEventListener(type: string, fn: any, _opts?: any) {
+ 104:       if (!listeners.has(type)) listeners.set(type, [])
+ 105:       listeners.get(type)!.push(fn)
+ 106:     },
+ 107:     removeEventListener(type: string, fn: any) {
+ 108:       const arr = listeners.get(type)
+ 109:       if (arr) { const idx = arr.indexOf(fn); if (idx &gt; -1) arr.splice(idx, 1) }
+ 110:     },
+ 111:     dispatchEvent(event: any) {
+ 112:       const arr = listeners.get(event.type as string)
+ 113:       arr?.forEach(fn =&gt; fn(event))
+ 114:       return true
+ 115:     },
+ 116:     _fire(type: string, ...args: any[]) {
+ 117:       const arr = listeners.get(type)
+ 118:       arr?.forEach(fn =&gt; fn(...args))
+ 119:     },
+ 120:     _listeners: listeners,
+ 121:   } as unknown as FakeEl
+ 122: 
+ 123:   return el
+ 124: }
