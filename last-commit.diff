+ 325: // Subscribe returns a channel that receives state events from all hosts
+ 326: func (m *Manager) Subscribe() chan state.StateEvent {
+ 327: 	ch := make(chan state.StateEvent, 64)
+ 328: 	m.subMu.Lock()
+ 329: 	m.subscribers = append(m.subscribers, ch)
+ 330: 	m.subMu.Unlock()
+ 331: 	return ch
+ 332: }
